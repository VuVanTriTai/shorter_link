# ===== Database =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_link_shortener
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# ===== JWT =====
# QUAN TRONG: Tao secret moi, it nhat 32 ky tu
# Cach tao: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_at_least_32_chars
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Google APIs =====
GOOGLE_SAFEBROWSING_KEY=your_google_safebrowsing_api_key
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id

# ===== App =====
APP_DOMAINS=localhost,127.0.0.1,your-domain.com

# ===== Frontend (Vite) =====
# De trong khi dung Docker (Nginx proxy tu dong)
# Dat URL cua server khi deploy (vd: https://your-domain.com)
VITE_API_URL=
